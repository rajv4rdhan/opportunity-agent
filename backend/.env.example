# ============================================================
# ScholarSwarm — environment template
# Copy this file to .env and fill in your keys:
#     cp backend/.env.example backend/.env
# NEVER commit .env (it is in .gitignore).
# ============================================================

# ---------- LLM (OpenAI-compatible gateway) ----------
# LiteLLM model strings. Smart = planning/SOP/ranking, Fast = extraction.
# Use the "openai/" prefix for any OpenAI-compatible endpoint.
# Check the gateway's model list and use its exact model IDs.
MODEL_SMART=openai/deepseek-v4.1-flash
MODEL_FAST=openai/deepseek-v4.1-flash
# Optional second model, used if the primary model fails twice.
MODEL_FALLBACK=openai/deepseek-v4.1-flash

# Base URL of the OpenAI-compatible API (must include /v1 when required).
# OpenCode Go: https://opencode.ai/inference/go/openai/v1
# The app sends the required x-opencode-session header automatically.
LLM_API_BASE=https://opencode.ai/inference/go/openai/v1
LLM_API_KEY=

# Native provider keys (only needed if you are not using LLM_API_BASE above):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------- Search (Tavily required; Exa / Serper optional fallbacks) ----------
TAVILY_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=

# ---------- Page fetching / browser ----------
# Jina Reader works without a key, but a key raises the rate limit.
JINA_API_KEY=
FIRECRAWL_API_KEY=
KERNEL_API_KEY=

# ---------- Profile enrichment ----------
# Optional. If left blank, the app uses GITHUB_TOKEN from the OS environment
# (already configured on this machine), otherwise unauthenticated requests.
GITHUB_TOKEN=

# ---------- Knowledge graph (optional; falls back to in-memory networkx) ----------
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ---------- Tracing (optional) ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- App ----------
# Any long random string. Signs NiceGUI session storage.
STORAGE_SECRET=change-me-to-a-long-random-string

# ---------- Tuning (optional — uncomment to override the defaults) ----------
# UI_POLL_SECONDS=0.5
# MAX_CANDIDATES_PER_ROUND=15
# MAX_SCOUT_ROUNDS=3
# MIN_VERIFIED_TARGET=10
# MIN_ELIGIBLE_TARGET=5
# VERIFIER_CONCURRENCY=5
# MAX_SOP_REVISIONS=2
# PAGE_CHAR_LIMIT=15000
# CACHE_TTL_HOURS=72
# RUN_TIMEOUT_MINUTES=15
